<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="ScreenPivot.App.PanelWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="ScreenPivot">

    <Window.SystemBackdrop>
        <DesktopAcrylicBackdrop />
    </Window.SystemBackdrop>

    <Grid
        x:Name="Root"
        Background="{ThemeResource LayerOnAcrylicFillColorDefaultBrush}"
        BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}"
        BorderThickness="1">
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="Escape" Invoked="OnEscape" />
        </Grid.KeyboardAccelerators>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Padding="12,10,8,6" ColumnSpacing="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button
                x:Name="BackButton"
                Click="OnBack"
                Visibility="Collapsed"
                Background="Transparent"
                BorderThickness="0"
                Padding="8"
                x:Uid="Panel_Back">
                <FontIcon Glyph="&#xE72B;" FontSize="14" />
            </Button>
            <TextBlock
                x:Name="TitleText"
                Grid.Column="1"
                Margin="4,0,0,0"
                Text="ScreenPivot"
                Style="{StaticResource SubtitleTextBlockStyle}"
                VerticalAlignment="Center" />
            <Button
                x:Name="SettingsButton"
                Grid.Column="2"
                Click="OnSettings"
                Background="Transparent"
                BorderThickness="0"
                Padding="8"
                x:Uid="Panel_Settings">
                <FontIcon Glyph="&#xE713;" FontSize="16" />
            </Button>
            <Button
                Grid.Column="3"
                Click="OnHide"
                Background="Transparent"
                BorderThickness="0"
                Padding="8"
                x:Uid="Panel_Hide">
                <FontIcon Glyph="&#xE711;" FontSize="14" />
            </Button>
        </Grid>

        <Frame x:Name="ContentFrame" Grid.Row="1" Navigated="OnNavigated" />
    </Grid>
</Window>
