<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ScreenPivot.App.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ScreenPivot.App.Pages"
    Background="Transparent">

    <Page.Resources>
        <Style x:Key="SectionTitle" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
            <Setter Property="Margin" Value="0,12,0,0" />
            <Setter Property="FontSize" Value="16" />
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        </Style>
        <Style x:Key="RuleCard" TargetType="Border">
            <Setter Property="Padding" Value="10" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer>
            <StackPanel Padding="16,0,16,16" Spacing="10">
                <InfoBar x:Name="AccessBar" IsOpen="True" IsClosable="False">
                    <InfoBar.ActionButton>
                        <Button x:Name="AccessButton" Click="OnAccessClick" />
                    </InfoBar.ActionButton>
                </InfoBar>
                <TextBlock x:Name="DetectionText" Style="{StaticResource Hint}" />

                <TextBlock x:Uid="Settings_GeneralSection" Style="{StaticResource SectionTitle}" />
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock x:Uid="Settings_Paused" TextWrapping="Wrap" VerticalAlignment="Center" />
                    <ToggleSwitch x:Name="PausedToggle" x:Uid="Settings_PausedToggle" Grid.Column="1" OnContent="" OffContent="" MinWidth="0" />
                </Grid>
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock x:Uid="Settings_Startup" TextWrapping="Wrap" VerticalAlignment="Center" />
                    <ToggleSwitch x:Name="StartupToggle" x:Uid="Settings_StartupToggle" Grid.Column="1" Toggled="OnStartupToggled" OnContent="" OffContent="" MinWidth="0" />
                </Grid>
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock x:Uid="Settings_DigestOnReturn" TextWrapping="Wrap" VerticalAlignment="Center" />
                    <ToggleSwitch x:Name="DigestToggle" x:Uid="Settings_DigestOnReturnToggle" Grid.Column="1" OnContent="" OffContent="" MinWidth="0" />
                </Grid>
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock x:Uid="Settings_Maximized" TextWrapping="Wrap" VerticalAlignment="Center" />
                    <ToggleSwitch x:Name="MaximizedToggle" x:Uid="Settings_MaximizedToggle" Grid.Column="1" OnContent="" OffContent="" MinWidth="0" />
                </Grid>
                <TextBlock x:Uid="Settings_MaximizedHint" Style="{StaticResource Hint}" />

                <TextBlock x:Uid="Settings_LanguageSection" Style="{StaticResource SectionTitle}" />
                <ComboBox x:Name="LanguageBox" x:Uid="Settings_Language" HorizontalAlignment="Stretch">
                    <ComboBoxItem x:Uid="Settings_LanguageAuto" Tag="" />
                    <ComboBoxItem Content="Español" Tag="es-ES" />
                    <ComboBoxItem Content="English" Tag="en-US" />
                </ComboBox>
                <StackPanel x:Name="RestartPanel" Orientation="Horizontal" Spacing="10" Visibility="Collapsed">
                    <TextBlock x:Uid="Settings_LanguageRestartHint" Style="{StaticResource Hint}" VerticalAlignment="Center" />
                    <Button x:Uid="Settings_Restart" Click="OnRestart" />
                </StackPanel>

                <TextBlock x:Uid="Settings_PanelSection" Style="{StaticResource SectionTitle}" />
                <ComboBox x:Name="PanelEdgeBox" x:Uid="Settings_PanelEdge" HorizontalAlignment="Stretch">
                    <ComboBoxItem x:Uid="Settings_EdgeLeft" />
                    <ComboBoxItem x:Uid="Settings_EdgeRight" />
                    <ComboBoxItem x:Uid="Settings_EdgeTop" />
                    <ComboBoxItem x:Uid="Settings_EdgeBottom" />
                </ComboBox>
                <ComboBox x:Name="PanelMonitorBox" x:Uid="Settings_PanelMonitor" HorizontalAlignment="Stretch" />

                <TextBlock x:Uid="Settings_AlertsSection" Style="{StaticResource SectionTitle}" />
                <ComboBox x:Name="CornerBox" x:Uid="Settings_Corner" HorizontalAlignment="Stretch">
                    <ComboBoxItem x:Uid="Settings_CornerTopLeft" />
                    <ComboBoxItem x:Uid="Settings_CornerTopRight" />
                    <ComboBoxItem x:Uid="Settings_CornerBottomLeft" />
                    <ComboBoxItem x:Uid="Settings_CornerBottomRight" />
                </ComboBox>
                <ComboBox x:Name="MonitorBox" x:Uid="Settings_BannerMonitor" HorizontalAlignment="Stretch" />
                <NumberBox x:Name="BannerSecondsBox" x:Uid="Settings_BannerSeconds" Minimum="2" Maximum="60" SpinButtonPlacementMode="Compact" HorizontalAlignment="Left" />
                <ComboBox x:Name="SwitchModeBox" x:Uid="Settings_SwitchMode" HorizontalAlignment="Stretch">
                    <ComboBoxItem x:Uid="Settings_SwitchBringToFront" />
                    <ComboBoxItem x:Uid="Settings_SwitchMinimize" />
                </ComboBox>
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock x:Uid="Settings_QuickAccess" TextWrapping="Wrap" VerticalAlignment="Center" />
                    <ToggleSwitch x:Name="QuickAccessToggle" x:Uid="Settings_QuickAccessToggle" Grid.Column="1" OnContent="" OffContent="" MinWidth="0" />
                </Grid>
                <Button x:Uid="Settings_TestBanner" Click="OnTestBanner" />
                <TextBlock x:Name="TestHint" Style="{StaticResource Hint}" />

                <TextBlock x:Uid="Settings_SoundsSection" Style="{StaticResource SectionTitle}" />
                <TextBlock x:Uid="Settings_SoundsHint" Style="{StaticResource Hint}" />
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock x:Uid="Settings_Sound" TextWrapping="Wrap" VerticalAlignment="Center" />
                    <ToggleSwitch x:Name="SoundToggle" x:Uid="Settings_SoundToggle" Grid.Column="1" OnContent="" OffContent="" MinWidth="0" />
                </Grid>
                <StackPanel x:Name="SoundRows" Spacing="8" />
                <TextBlock x:Name="SoundStatus" Style="{StaticResource Hint}" />

                <TextBlock x:Uid="Settings_PrioritiesSection" Style="{StaticResource SectionTitle}" />
                <TextBlock x:Uid="Settings_PrioritiesHint" Style="{StaticResource Hint}" />
                <TextBox x:Name="VipBox" x:Uid="Settings_Vip" AcceptsReturn="True" MinHeight="72" TextWrapping="Wrap" />
                <TextBox x:Name="KeywordsBox" x:Uid="Settings_Keywords" AcceptsReturn="True" MinHeight="72" TextWrapping="Wrap" />
                <TextBox x:Name="MutedBox" x:Uid="Settings_Muted" AcceptsReturn="True" MinHeight="72" TextWrapping="Wrap" />

                <TextBlock x:Uid="Settings_RulesSection" Style="{StaticResource SectionTitle}" />
                <ItemsControl x:Name="RulesList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="local:RuleRow">
                            <Border Style="{StaticResource RuleCard}">
                                <StackPanel Spacing="6">
                                    <Grid ColumnSpacing="6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <CheckBox IsChecked="{x:Bind Enabled, Mode=TwoWay}" MinWidth="0" VerticalAlignment="Center"
                                                  x:Uid="Settings_RuleEnabled" />
                                        <TextBox Grid.Column="1" x:Uid="Settings_RuleName" Text="{x:Bind Name, Mode=TwoWay}" />
                                        <Button Grid.Column="2" Click="OnRemoveRule" Tag="{x:Bind}" Padding="8"
                                                x:Uid="Settings_RuleRemove">
                                            <FontIcon Glyph="&#xE74D;" FontSize="14" />
                                        </Button>
                                    </Grid>
                                    <Grid ColumnSpacing="6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Uid="Settings_RuleApp" Text="{x:Bind App, Mode=TwoWay}" />
                                        <ComboBox Grid.Column="1" ItemsSource="{x:Bind local:RuleRow.PriorityNames}" SelectedIndex="{x:Bind PriorityIndex, Mode=TwoWay}" MinWidth="110" />
                                    </Grid>
                                    <TextBox x:Uid="Settings_RuleKeywords" Text="{x:Bind Keywords, Mode=TwoWay}" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button x:Uid="Settings_AddRule" Click="OnAddRule" />

                <TextBlock x:Uid="Settings_NoToastSection" Style="{StaticResource SectionTitle}" />
                <TextBlock x:Uid="Settings_NoToastHint" Style="{StaticResource Hint}" />
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock x:Uid="Settings_Flashes" TextWrapping="Wrap" VerticalAlignment="Center" />
                    <ToggleSwitch x:Name="FlashToggle" x:Uid="Settings_FlashesToggle" Grid.Column="1" OnContent="" OffContent="" MinWidth="0" />
                </Grid>
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock x:Uid="Settings_Titles" TextWrapping="Wrap" VerticalAlignment="Center" />
                    <ToggleSwitch x:Name="TitlesToggle" x:Uid="Settings_TitlesToggle" Grid.Column="1" OnContent="" OffContent="" MinWidth="0" />
                </Grid>
                <ItemsControl x:Name="TitleRulesList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="local:TitleRuleRow">
                            <Border Style="{StaticResource RuleCard}">
                                <StackPanel Spacing="6">
                                    <Grid ColumnSpacing="6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <CheckBox IsChecked="{x:Bind Enabled, Mode=TwoWay}" MinWidth="0" VerticalAlignment="Center"
                                                  x:Uid="Settings_RuleEnabled" />
                                        <TextBox Grid.Column="1" x:Uid="Settings_RuleName" Text="{x:Bind Name, Mode=TwoWay}" />
                                        <Button Grid.Column="2" Click="OnRemoveTitleRule" Tag="{x:Bind}" Padding="8"
                                                x:Uid="Settings_RuleRemove">
                                            <FontIcon Glyph="&#xE74D;" FontSize="14" />
                                        </Button>
                                    </Grid>
                                    <Grid ColumnSpacing="6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Uid="Settings_RuleApp" Text="{x:Bind App, Mode=TwoWay}" />
                                        <ComboBox Grid.Column="1" ItemsSource="{x:Bind local:TitleRuleRow.PriorityNames}" SelectedIndex="{x:Bind PriorityIndex, Mode=TwoWay}" MinWidth="110" />
                                    </Grid>
                                    <TextBox x:Uid="Settings_RulePattern" FontFamily="Consolas" Text="{x:Bind Pattern, Mode=TwoWay}" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button x:Uid="Settings_AddTitleRule" Click="OnAddTitleRule" />

                <TextBlock x:Uid="Settings_PrivacySection" Style="{StaticResource SectionTitle}" />
                <TextBlock x:Uid="Settings_PrivacyHint" Style="{StaticResource Hint}" />
                <HyperlinkButton x:Name="PrivacyLink" x:Uid="Settings_PrivacyLink" Padding="0" />
                <NumberBox x:Name="RetentionBox" x:Uid="Settings_Retention" Minimum="1" Maximum="168" SpinButtonPlacementMode="Compact" HorizontalAlignment="Left" />
            </StackPanel>
        </ScrollViewer>

        <Grid
            Grid.Row="1"
            Padding="12"
            ColumnSpacing="10"
            Background="{ThemeResource LayerFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button x:Uid="Settings_Save" Style="{StaticResource AccentButtonStyle}" Click="OnSave" MinWidth="100" />
            <TextBlock x:Name="SavedText" Grid.Column="1" Style="{StaticResource Hint}" VerticalAlignment="Center" />
        </Grid>
    </Grid>
</Page>
