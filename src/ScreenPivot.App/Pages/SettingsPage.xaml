<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ScreenPivot.App.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ScreenPivot.App.Pages"
    Background="Transparent">

    <Page.Resources>
        <Style x:Key="SectionTitle" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
            <Setter Property="Margin" Value="0,12,0,0" />
            <Setter Property="FontSize" Value="16" />
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        </Style>
        <Style x:Key="RuleCard" TargetType="Border">
            <Setter Property="Padding" Value="10" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer>
            <StackPanel Padding="16,0,16,16" Spacing="10">
                <InfoBar x:Name="AccessBar" IsOpen="True" IsClosable="False">
                    <InfoBar.ActionButton>
                        <Button x:Name="AccessButton" Click="OnAccessClick" />
                    </InfoBar.ActionButton>
                </InfoBar>
                <TextBlock x:Name="DetectionText" Style="{StaticResource Hint}" />

                <TextBlock Text="General" Style="{StaticResource SectionTitle}" />
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock Text="Pausar avisos" TextWrapping="Wrap" VerticalAlignment="Center" />
                    <ToggleSwitch x:Name="PausedToggle" Grid.Column="1" OnContent="" OffContent="" MinWidth="0" AutomationProperties.Name="Pausar avisos" />
                </Grid>
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock Text="Iniciar con Windows" TextWrapping="Wrap" VerticalAlignment="Center" />
                    <ToggleSwitch x:Name="StartupToggle" Grid.Column="1" Toggled="OnStartupToggled" OnContent="" OffContent="" MinWidth="0" AutomationProperties.Name="Iniciar con Windows" />
                </Grid>
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock Text="Abrir el resumen al salir del Cloud PC" TextWrapping="Wrap" VerticalAlignment="Center" />
                    <ToggleSwitch x:Name="DigestToggle" Grid.Column="1" OnContent="" OffContent="" MinWidth="0" AutomationProperties.Name="Abrir el resumen al salir del Cloud PC" />
                </Grid>
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock Text="Contar el Cloud PC maximizado" TextWrapping="Wrap" VerticalAlignment="Center" />
                    <ToggleSwitch x:Name="MaximizedToggle" Grid.Column="1" OnContent="" OffContent="" MinWidth="0" AutomationProperties.Name="Contar el Cloud PC maximizado" />
                </Grid>
                <TextBlock Style="{StaticResource Hint}" Text="Además de a pantalla completa, cuando la sesión está maximizada y se ve la barra de tareas del equipo." />

                <TextBlock Text="Panel lateral" Style="{StaticResource SectionTitle}" />
                <ComboBox x:Name="PanelEdgeBox" Header="Borde" HorizontalAlignment="Stretch">
                    <x:String>Izquierda</x:String>
                    <x:String>Derecha</x:String>
                    <x:String>Arriba</x:String>
                    <x:String>Abajo</x:String>
                </ComboBox>
                <ComboBox x:Name="PanelMonitorBox" Header="Monitor" HorizontalAlignment="Stretch" />

                <TextBlock Text="Avisos sobre el Cloud PC" Style="{StaticResource SectionTitle}" />
                <ComboBox x:Name="CornerBox" Header="Esquina del banner" HorizontalAlignment="Stretch">
                    <x:String>Arriba a la izquierda</x:String>
                    <x:String>Arriba a la derecha</x:String>
                    <x:String>Abajo a la izquierda</x:String>
                    <x:String>Abajo a la derecha</x:String>
                </ComboBox>
                <ComboBox x:Name="MonitorBox" Header="Monitor del banner" HorizontalAlignment="Stretch" />
                <NumberBox x:Name="BannerSecondsBox" Header="Segundos del aviso alto" Minimum="2" Maximum="60" SpinButtonPlacementMode="Compact" HorizontalAlignment="Left" />
                <ComboBox x:Name="SwitchModeBox" Header="Al abrir una app desde un aviso" HorizontalAlignment="Stretch">
                    <x:String>Traerla encima del Cloud PC</x:String>
                    <x:String>Minimizar el Cloud PC</x:String>
                </ComboBox>
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock Text="Mostrar siempre «Ir al equipo»" TextWrapping="Wrap" VerticalAlignment="Center" />
                    <ToggleSwitch x:Name="QuickAccessToggle" Grid.Column="1" OnContent="" OffContent="" MinWidth="0" AutomationProperties.Name="Mostrar siempre «Ir al equipo»" />
                </Grid>
                <Button Content="Probar banner en 5 s" Click="OnTestBanner" />
                <TextBlock x:Name="TestHint" Style="{StaticResource Hint}" />

                <TextBlock Text="Sonidos" Style="{StaticResource SectionTitle}" />
                <TextBlock Style="{StaticResource Hint}"
                           Text="Solo para avisos que llegan mientras estás en el Cloud PC. Los sonidos de Windows siguen tu esquema de sonido." />
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock Text="Reproducir sonidos" TextWrapping="Wrap" VerticalAlignment="Center" />
                    <ToggleSwitch x:Name="SoundToggle" Grid.Column="1" OnContent="" OffContent="" MinWidth="0" AutomationProperties.Name="Reproducir sonidos" />
                </Grid>
                <StackPanel x:Name="SoundRows" Spacing="8" />
                <TextBlock x:Name="SoundStatus" Style="{StaticResource Hint}" />

                <TextBlock Text="Prioridades" Style="{StaticResource SectionTitle}" />
                <TextBlock Style="{StaticResource Hint}"
                           Text="Orden: app silenciada → remitente VIP → palabra clave crítica → la regla de mayor prioridad → Normal. Una entrada por línea." />
                <TextBox x:Name="VipBox" Header="Remitentes VIP (críticos)" AcceptsReturn="True" MinHeight="72" TextWrapping="Wrap" />
                <TextBox x:Name="KeywordsBox" Header="Palabras clave críticas" AcceptsReturn="True" MinHeight="72" TextWrapping="Wrap" />
                <TextBox x:Name="MutedBox" Header="Apps silenciadas" AcceptsReturn="True" MinHeight="72" TextWrapping="Wrap" />

                <TextBlock Text="Reglas por app" Style="{StaticResource SectionTitle}" />
                <ItemsControl x:Name="RulesList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="local:RuleRow">
                            <Border Style="{StaticResource RuleCard}">
                                <StackPanel Spacing="6">
                                    <Grid ColumnSpacing="6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <CheckBox IsChecked="{x:Bind Enabled, Mode=TwoWay}" MinWidth="0" VerticalAlignment="Center"
                                                  AutomationProperties.Name="Activa" ToolTipService.ToolTip="Activa" />
                                        <TextBox Grid.Column="1" PlaceholderText="Nombre" Text="{x:Bind Name, Mode=TwoWay}" />
                                        <Button Grid.Column="2" Click="OnRemoveRule" Tag="{x:Bind}" Padding="8"
                                                ToolTipService.ToolTip="Quitar regla" AutomationProperties.Name="Quitar regla">
                                            <FontIcon Glyph="&#xE74D;" FontSize="14" />
                                        </Button>
                                    </Grid>
                                    <Grid ColumnSpacing="6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox PlaceholderText="App (cualquiera)" Text="{x:Bind App, Mode=TwoWay}" />
                                        <ComboBox Grid.Column="1" ItemsSource="{x:Bind local:RuleRow.PriorityNames}" SelectedIndex="{x:Bind PriorityIndex, Mode=TwoWay}" MinWidth="110" />
                                    </Grid>
                                    <TextBox PlaceholderText="Palabras, separadas por coma (cualquier texto)" Text="{x:Bind Keywords, Mode=TwoWay}" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button Content="Agregar regla" Click="OnAddRule" />

                <TextBlock Text="Apps sin notificaciones" Style="{StaticResource SectionTitle}" />
                <TextBlock Style="{StaticResource Hint}"
                           Text="Solo mientras estás en el Cloud PC, y nunca de la ventana que tienes delante. Si el patrón tiene un primer grupo numérico, por ejemplo ^\((\d+)\), avisa cuando ese número sube; si no, cuando el texto aparece o cambia." />
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock Text="Parpadeos en la barra de tareas" TextWrapping="Wrap" VerticalAlignment="Center" />
                    <ToggleSwitch x:Name="FlashToggle" Grid.Column="1" OnContent="" OffContent="" MinWidth="0" AutomationProperties.Name="Parpadeos en la barra de tareas" />
                </Grid>
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock Text="Cambios en el título de las ventanas" TextWrapping="Wrap" VerticalAlignment="Center" />
                    <ToggleSwitch x:Name="TitlesToggle" Grid.Column="1" OnContent="" OffContent="" MinWidth="0" AutomationProperties.Name="Cambios en el título de las ventanas" />
                </Grid>
                <ItemsControl x:Name="TitleRulesList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="local:TitleRuleRow">
                            <Border Style="{StaticResource RuleCard}">
                                <StackPanel Spacing="6">
                                    <Grid ColumnSpacing="6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <CheckBox IsChecked="{x:Bind Enabled, Mode=TwoWay}" MinWidth="0" VerticalAlignment="Center"
                                                  AutomationProperties.Name="Activa" ToolTipService.ToolTip="Activa" />
                                        <TextBox Grid.Column="1" PlaceholderText="Nombre" Text="{x:Bind Name, Mode=TwoWay}" />
                                        <Button Grid.Column="2" Click="OnRemoveTitleRule" Tag="{x:Bind}" Padding="8"
                                                ToolTipService.ToolTip="Quitar regla" AutomationProperties.Name="Quitar regla">
                                            <FontIcon Glyph="&#xE74D;" FontSize="14" />
                                        </Button>
                                    </Grid>
                                    <Grid ColumnSpacing="6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox PlaceholderText="App (cualquiera)" Text="{x:Bind App, Mode=TwoWay}" />
                                        <ComboBox Grid.Column="1" ItemsSource="{x:Bind local:TitleRuleRow.PriorityNames}" SelectedIndex="{x:Bind PriorityIndex, Mode=TwoWay}" MinWidth="110" />
                                    </Grid>
                                    <TextBox PlaceholderText="Patrón (expresión regular)" FontFamily="Consolas" Text="{x:Bind Pattern, Mode=TwoWay}" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button Content="Agregar regla de título" Click="OnAddTitleRule" />

                <TextBlock Text="Privacidad" Style="{StaticResource SectionTitle}" />
                <TextBlock Style="{StaticResource Hint}"
                           Text="Todo se procesa en este equipo. El historial se guarda cifrado para tu usuario de Windows y se borra pasado el periodo de retención." />
                <HyperlinkButton x:Name="PrivacyLink" Content="Política de privacidad" Padding="0" />
                <NumberBox x:Name="RetentionBox" Header="Retención del historial (horas)" Minimum="1" Maximum="168" SpinButtonPlacementMode="Compact" HorizontalAlignment="Left" />
            </StackPanel>
        </ScrollViewer>

        <Grid
            Grid.Row="1"
            Padding="12"
            ColumnSpacing="10"
            Background="{ThemeResource LayerFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button Content="Guardar" Style="{StaticResource AccentButtonStyle}" Click="OnSave" MinWidth="100" />
            <TextBlock x:Name="SavedText" Grid.Column="1" Style="{StaticResource Hint}" VerticalAlignment="Center" />
        </Grid>
    </Grid>
</Page>
