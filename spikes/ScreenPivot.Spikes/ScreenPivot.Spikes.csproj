<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>ScreenPivot.Spikes</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- File description seen by the activity source; must not contain "ScreenPivot" (muted by default). -->
    <AssemblyTitle>SP Diagnostics</AssemblyTitle>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\ScreenPivot.Core\ScreenPivot.Core.csproj" />
  </ItemGroup>

</Project>
